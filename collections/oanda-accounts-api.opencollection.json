                "description": "Account Identifier"
              },
              {
                "name": "instrument",
                "value": "",
                "type": "path",
                "description": "Name of the Instrument"
              }
            ]
          },
          "docs": "Get the details of a single Instrument's Position in an Account. The Position may by open or not."
        },
        {
          "info": {
